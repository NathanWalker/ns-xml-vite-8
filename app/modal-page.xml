<Page xmlns="http://schemas.nativescript.org/tns.xsd" shownModally="onShownModally">
    <StackLayout class="p-20">
        <Label text="{{ title }}" class="h1 text-center" />
        <Label text="{{ description }}" class="h2 text-center" textWrap="true" marginTop="12" />
        <Button text="Close modal" tap="closeModal" marginTop="20" class="-primary" />
    </StackLayout>
</Page>